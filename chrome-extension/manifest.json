{
  "manifest_version": 3,
  "name": "Pajakia Coretax Co-Pilot",
  "version": "0.1.0",
  "description": "Auto-fill Coretax forms, decode errors inline, save drafts every 30 seconds. Built for Indonesian tax consultants.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://coretax.pajak.go.id/*",
    "https://*.pajakia.com/*",
    "https://pajakai.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://coretax.pajak.go.id/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.html"],
      "matches": ["https://coretax.pajak.go.id/*"]
    }
  ]
}
